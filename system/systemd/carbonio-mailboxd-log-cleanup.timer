[Unit]
Description=Carbonio mailboxd log and stacktrace cleanup timer
PartOf=carbonio-appserver.target

[Timer]
OnCalendar=*-*-* 02:30:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=carbonio-appserver.target
