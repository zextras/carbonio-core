[Unit]
Description=Carbonio SpamAssassin Bayes expiry
After=carbonio-mta.target

[Service]
Type=oneshot
User=zextras
Group=zextras
ExecStart=/opt/zextras/common/bin/sa-learn --dbpath /opt/zextras/data/amavisd/.spamassassin --force-expire --sync
