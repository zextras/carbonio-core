[Unit]
Description=Carbonio Rotated Log Cleanup Daily
Documentation=https://docs.zextras.com/
PartOf=carbonio.target

[Timer]
OnCalendar=*-*-* 02:30:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=carbonio.target
