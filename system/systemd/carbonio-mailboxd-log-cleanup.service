[Unit]
Description=Carbonio mailboxd log and stacktrace cleanup
After=carbonio-appserver.target

[Service]
Type=oneshot
User=zextras
Group=zextras
ExecStart=/usr/bin/find /opt/zextras/mailboxd/logs/ -type f -name '*log*' -mtime +8 -delete
ExecStart=/usr/bin/find /opt/zextras/log/ -type f -name 'stacktrace.*' -mtime +8 -delete
Nice=10
IOSchedulingClass=idle
