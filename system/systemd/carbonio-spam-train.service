[Unit]
Description=Carbonio spam training
After=carbonio-mta.target

[Service]
Type=oneshot
User=zextras
Group=zextras
ExecStart=/opt/zextras/bin/zmtrainsa
StandardOutput=append:/opt/zextras/log/spamtrain.log
StandardError=append:/opt/zextras/log/spamtrain.log
