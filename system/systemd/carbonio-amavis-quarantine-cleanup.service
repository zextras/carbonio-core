[Unit]
Description=Carbonio amavisd quarantine cleanup
After=carbonio-mta.target

[Service]
Type=oneshot
User=zextras
Group=zextras
ExecStart=/usr/bin/find /opt/zextras/data/amavisd/quarantine -type f -mtime +7 -delete
Nice=10
IOSchedulingClass=idle
