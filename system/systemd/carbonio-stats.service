[Unit]
Description=Carbonio Stats Daemon
PartOf=carbonio-appserver.target carbonio-directory-server.target carbonio-mta.target carbonio-proxy.target

[Service]
User=zextras
# configd starts one process that runs all the collectors ("configd stat run ..."),
# detached, and returns; the process writes /run/carbonio/stats/stats.pid. Every
# collector runs as zextras without sudo, so NoNewPrivileges below does not
# keep any of them from working.
Type=forking
PIDFile=/run/carbonio/stats/stats.pid
ExecStart=/opt/zextras/bin/zmstatctl start-systemd
ExecStop=/opt/zextras/bin/zmstatctl stop-systemd
RestartSec=3s
Restart=on-failure

# Hardening
PrivateTmp=yes
#ProtectSystem=strict
#ReadWritePaths=/opt/zextras/log /opt/zextras/data /opt/zextras/zmstat /run/carbonio
ProtectSystem=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=carbonio-appserver.target carbonio-directory-server.target carbonio-mta.target carbonio-proxy.target
