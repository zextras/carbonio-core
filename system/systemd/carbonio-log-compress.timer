[Unit]
Description=Carbonio Log Compression Daily
Documentation=https://docs.zextras.com/

[Timer]
OnCalendar=*-*-* 02:50:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=carbonio.target
