postrm__apt() {
  if [ "$1" = purge ]; then
    if crontab -l -u "zextras" >"/dev/null"; then
      crontab -r -u "zextras"
    fi
  fi
}

postrm__yum() {
  if crontab -l -u "zextras" >"/dev/null"; then
    crontab -r -u "zextras"
  fi
}

postinst__rocky_8() {
  _postinst
  _postinst_legacy
}

postinst__rocky_9() {
  _postinst
  _postinst_systemd

  # Remove old init scripts on upgrade
  rm -f /etc/init.d/carbonio
}

postinst__ubuntu_jammy() {
  _postinst
  _postinst_legacy
}

postinst__ubuntu_noble() {
  _postinst
  _postinst_systemd

  # Remove old init scripts on upgrade
  rm -f /etc/init.d/carbonio
}
